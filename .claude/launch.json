{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Vite Frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "Vite Only",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port=3000", "--host=0.0.0.0"],
      "port": 3000
    },
    {
      "name": "Express Backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server"],
      "port": 3001
    },
    {
      "name": "Vite Only Alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port=3050", "--host=0.0.0.0"],
      "port": 3050
    }
  ]
}
