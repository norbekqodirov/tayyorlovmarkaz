model OnlineTransaction {
  id            String    @id @default(uuid())
  provider      String    // "payme" or "click"
  transactionId String    @unique // provider's transaction ID (e.g. click_trans_id or payme's _id)
  amount        Float
  studentId     String
  state         Int       // For payme: 1 = created, 2 = performed, -1 = canceled, -2 = canceled after perform. For click: 0 = prepare, 1 = complete, 2 = cancel.
  reason        Int?      // cancellation reason code
  createdAt     DateTime  @default(now())
  performAt     DateTime?
  cancelAt      DateTime?
}

// ============================================
// FAZA 1.1 — KENGAYTIRILGAN MOLIYA MODELLARI
// ============================================

model Invoice {
  id          String        @id @default(uuid())
  number      String        @unique // INV-2025-0001
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Float
  discount    Float         @default(0)
  tax         Float         @default(0)
  status      String        @default("pending") // pending, paid, overdue, cancelled
  dueDate     String
  paidAt      DateTime?
  method      String?       // Naqd, Payme, Click, Bank, Karta
  description String?       @db.Text
  items       InvoiceItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int     @default(1)
  price     Float
}

model Expense {
  id          String   @id @default(uuid())
  category    String   // SALARY, RENT, UTILITIES, SUPPLIES, MARKETING, EQUIPMENT, OTHER
  amount      Float
  description String   @db.Text
  date        String
  receipt     String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Budget {
  id       String @id @default(uuid())
  month    Int
  year     Int
  category String
  planned  Float
  actual   Float  @default(0)

  @@unique([month, year, category])
}

// ============================================
// FAZA 1.3 — ALOQA MARKAZI MODELLARI
// ============================================

model MessageTemplate {
  id        String   @id @default(uuid())
  name      String
  content   String   @db.Text // {{student_name}}, {{amount}}, {{date}} o'zgaruvchilar
  type      String   @default("CUSTOM") // PAYMENT_REMINDER, LESSON_REMINDER, WELCOME, BIRTHDAY, ANNOUNCEMENT, RESULT, CUSTOM
  language  String   @default("uz")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BulkMessage {
  id         String   @id @default(uuid())
  templateId String?
  content    String   @db.Text
  targetType String   // "group", "course", "all", "debtors", "leads"
  targetId   String?
  sentAt     DateTime?
  sentCount  Int      @default(0)
  status     String   @default("draft") // draft, sent, failed
  createdAt  DateTime @default(now())
}

// ============================================
// FAZA 1.4 — OTA-ONA MODELI
// ============================================

model Parent {
  id         String    @id @default(uuid())
  name       String
  phone      String
  telegramId String?
  createdAt  DateTime  @default(now())
  children   Student[] @relation("StudentParent")
}

// ============================================
// FAZA 3 — TEST TIZIMI
// ============================================

model Quiz {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  courseId    String?
  groupId     String?
  duration    Int          @default(30) // daqiqada
  maxScore    Int          @default(100)
  passingScore Int         @default(60)
  isPublic    Boolean      @default(false) // lid uchun ochiq test
  publicSlug  String?      @unique        // /test/<slug>
  status      String       @default("draft") // draft, active, archived
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  questions   QuizQuestion[]
  attempts    QuizAttempt[]
}

model QuizQuestion {
  id        String         @id @default(uuid())
  quizId    String
  quiz      Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text      String         @db.Text
  type      String         @default("single") // single, multiple, text
  order     Int            @default(0)
  points    Int            @default(1)
  imageUrl  String?
  options   QuizOption[]
  answers   QuizAnswer[]
}

model QuizOption {
  id         String       @id @default(uuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)
}

model QuizAttempt {
  id          String       @id @default(uuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId   String?      // null = anonim (lid)
  studentName String?      // anonim uchun
  studentPhone String?     // anonim uchun
  score       Float        @default(0)
  maxScore    Float        @default(0)
  passed      Boolean      @default(false)
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  timeSpent   Int?         // soniyada
  answers     QuizAnswer[]
}

model QuizAnswer {
  id          String       @id @default(uuid())
  attemptId   String
  attempt     QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptions String   @db.Text // JSON: option ID lari ro'yxati
  textAnswer  String?      @db.Text
  isCorrect   Boolean      @default(false)
  points      Float        @default(0)
}

// ============================================
// FAZA 5.3 — KPI VA MAQSADLAR
// ============================================

model Goal {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  type        String   // revenue, students, leads, attendance, conversion
  target      Float
  current     Float    @default(0)
  unit        String   @default("ta") // ta, so'm, %
  period      String   // monthly, quarterly, yearly
  month       Int?
  year        Int
  assignedTo  String?  // userId
  status      String   @default("active") // active, completed, failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// TELEGRAM XABARLARI
// ============================================

model TelegramMessage {
  id        String   @id @default(uuid())
  chatId    String
  type      String   // attendance, payment, grade, schedule, lead, broadcast
  message   String   @db.Text
  status    String   @default("pending") // pending, sent, delivered, failed
  entityId  String?
  error     String?
  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// AVTOMATIK WORKFLOWLAR
// ============================================

model Workflow {
  id          String    @id @default(uuid())
  name        String
  description String?
  trigger     String    // daily_payment, daily_attendance, hourly_leads, group_lifecycle
  isActive    Boolean   @default(true)
  config      String    @default("{}") @db.Text
  lastRun     DateTime?
  nextRun     DateTime?
  runCount    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  logs WorkflowLog[]
}

model WorkflowLog {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status     String   // success, error, skipped
  output     String?  @db.Text
  duration   Int?
  createdAt  DateTime @default(now())

  @@index([workflowId])
  @@index([createdAt])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  action     String   // create, update, delete, restore, login, logout
  resource   String
  resourceId String?
  before     String?  @db.Text
  after      String?  @db.Text
  ipAddress  String?
  userAgent  String?
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
}

// ============================================
// XODIM MAOSH VA DAVOMAT
// ============================================

model Salary {
  id         String      @id @default(uuid())
  staffId    String
  staff      StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month      String      // "2026-05"
  baseSalary Float       @default(0)
  bonus      Float       @default(0)
  deduction  Float       @default(0)
  total      Float       @default(0)
  // Payroll-avans (2026-09-17): TeacherPayroll bilan bir xil qisman
  // to'lash + avans naqshi — "paid" endi FAQAT (paidAmount+advanceApplied
  // >= total) bo'lganda true bo'ladigan hosila belgi, PUT /:id/pay esa
  // qisman summa bilan chaqirilishi mumkin (avval faqat to'liq/hech qanday
  // oraliq holatsiz edi).
  paidAmount     Float     @default(0)
  advanceApplied Float     @default(0)
  paid       Boolean     @default(false)
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([staffId, month])
  @@index([staffId])
}

model StaffAttendance {
  id          String        @id @default(uuid())
  staffId     String
  staff       StaffMember   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date        String        // "2026-06-25"
  checkIn     String?       // "09:05"
  checkOut    String?       // "18:00"
  status      String        @default("pending") // pending, present, late, absent
  locationId  String?
  location    WorkLocation? @relation(fields: [locationId], references: [id])
  checkInLat  Float?
  checkInLng  Float?
  checkOutLat Float?
  checkOutLng Float?
  faceScore   Float?        // 0-1, face match confidence
  verifiedBy  String        @default("face_id") // face_id, manual, admin
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([staffId, date])
  @@index([staffId, date])
  @@index([date])
}

// ============================================
// FACE ID VA ISH JOYLARI
// ============================================

model WorkLocation {
  id            String           @id @default(uuid())
  name          String
  address       String?
  latitude      Float
  longitude     Float
  radius        Int              @default(200)    // metr
  workStartTime String           @default("09:00") // HH:MM
  lateAfterMin  Int              @default(15)     // necha daqiqadan keyin kech = "late"
  branchId      String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  attendances   StaffAttendance[]

  @@index([isActive])
}

model StaffFaceProfile {
  id           String      @id @default(uuid())
  staffId      String      @unique
  staff        StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  descriptor   String      @db.Text  // JSON: 128-element Float32Array
  photoUrl     String?
  registeredAt DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// ============================================
// INVENTAR TRANZAKSIYALAR
// ============================================

model InventoryTransaction {
  id        String        @id @default(uuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String        // in, out, adjustment, damage
  quantity  Int
  reason    String?
  userId    String?
  userName  String?
  createdAt DateTime      @default(now())

  @@index([itemId, createdAt])
  @@index([type])
}

// ============================================
// SERTIFIKATLAR
// ============================================

model CertificateTemplate {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("certificate")
  background  String?
  config      String   @default("{\"elements\":[]}") @db.Text
  width       Int      @default(842)
  height      Int      @default(595)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  certificates Certificate[]
}

model Certificate {
  id             String              @id @default(uuid())
  templateId     String
  template       CertificateTemplate @relation(fields: [templateId], references: [id])
  studentId      String
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId       String?
  course         Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  serialNumber   String              @unique
  issuedAt       DateTime            @default(now())
  issuedBy       String?
  signature      String?
  qrCode         String?
  metadata       String?             @db.Text
  pdfUrl         String?
  grade          String?
  revokedAt      DateTime?
  revokedReason  String?

  @@index([studentId])
  @@index([serialNumber])
}

// ============================================
// HISOBOT SHABLONLAR
// ============================================

model ReportTemplate {
  id        String   @id @default(uuid())
  name      String
  type      String   // financial, attendance, students, teachers
  config    String   @default("{}") @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// E'LONLAR (ANNOUNCEMENTS)
// ============================================

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String    @db.Text
  type      String    @default("general") // general, urgent, event, maintenance
  audience  String    @default("all")     // all, students, staff, teachers
  priority  String    @default("normal")  // normal, high, critical
  pinned    Boolean   @default(false)
  expiresAt DateTime?
  createdBy String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([audience])
  @@index([createdAt])
}

// ============================================
// ICHKI XABARLAR (MESSAGES)
// ============================================

model Message {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String
  senderType String    @default("admin")
  content    String    @db.Text
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, readAt])
}

// ============================================
// CHEGIRMALAR
// ============================================

model Discount {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String?
  type      String   // percent, fixed
  value     Float
  maxUses   Int?
  usedCount Int      @default(0)
  validFrom String?
  validTo   String?
  courseId  String?
  groupId   String?
  minAmount Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications DiscountApplication[]

  @@index([code])
  @@index([isActive])
}

// Finance-audit (2026-09-16), F17: `/discounts/validate` promo-kodni
// tekshirardi, lekin HECH QAYERDA `usedCount`ni oshiradigan yoki qo'llash
// hodisasini yozadigan FAOL yo'l yo'q edi — `maxUses` cheklovi amalda hech
// qachon ishlamas edi. Bu jadval har bir haqiqiy qo'llashni (kim, qachon,
// qaysi invoice/o'quvchiga, qancha summaga) yozadi — `/discounts/apply`
// shu yozuvni `Discount.usedCount`ni ATOMAR oshirish bilan bir vaqtda yaratadi.
model DiscountApplication {
  id          String   @id @default(uuid())
  discountId  String
  discount    Discount @relation(fields: [discountId], references: [id])
  studentId   String?
  invoiceId   String?
  amount      Float    // haqiqiy chegirma summasi (so'mda, tur percent/fixed'dan qat'i nazar)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([discountId])
}

// ============================================
// MEHNAT TA'TILLARI
// ============================================

model LeaveRequest {
  id         String      @id @default(uuid())
  staffId    String
  staff      StaffMember @relation(fields: [staffId], references: [id])
  type       String      // annual, sick, personal, unpaid
  startDate  String
  endDate    String
  reason     String?
  status     String      @default("pending") // pending, approved, rejected
  approvedBy String?
  approvedAt DateTime?
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([staffId, status])
  @@index([status])
}

// ============================================
// KURS DARAJALARI VA MODULLARI (CURRICULUM)
// ============================================

model CourseLevel {
  id          String        @id @default(uuid())
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order       Int           @default(0)
  name        String
  description String?
  createdAt   DateTime      @default(now())
  modules     CourseModule[]

  @@index([courseId, order])
}

model CourseModule {
  id          String      @id @default(uuid())
  levelId     String
  level       CourseLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  order       Int         @default(0)
  title       String
  description String?
  materials   String?     @db.Text
  duration    Int?
  createdAt   DateTime    @default(now())

  @@index([levelId, order])
}

// ============================================
// FILIALLAR (BRANCHES)
// ============================================

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  status    String   @default("active")
  managerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ============================================
// IMTIHON TIZIMI (TESTS / EXAMS)
// ============================================

model Test {
  id               String   @id @default(uuid())
  title            String
  description      String?
  courseId         String?
  course           Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  groupId          String?
  group            Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  duration         Int      @default(60)
  totalScore       Float    @default(100)
  passingScore     Float    @default(60)
  shuffleQuestions Boolean  @default(false)
  shuffleOptions   Boolean  @default(false)
  showResults      Boolean  @default(true)
  scheduledStart   String?
  scheduledEnd     String?
  status           String   @default("draft")
  createdBy        String?
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  questions   Question[]
  submissions TestSubmission[]

  @@index([courseId])
  @@index([groupId])
  @@index([status])
}

model Question {
  id            String   @id @default(uuid())
  testId        String
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  order         Int      @default(0)
  type          String
  text          String
  imageUrl      String?
  options       String   @default("[]") @db.Text
  correctAnswer String?
  score         Float    @default(1)
  explanation   String?

  answers Answer[]

  @@index([testId, order])
}

model TestSubmission {
  id          String    @id @default(uuid())
  testId      String
  test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Float?
  status      String    @default("in_progress")
  cheating    Boolean   @default(false)
  metadata    String?   @db.Text

  answers Answer[]

  @@unique([testId, studentId])
  @@index([studentId])
  @@index([status])
}

model Answer {
  id           String         @id @default(uuid())
  submissionId String
  submission   TestSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value        String         @db.Text
  score        Float?
  isCorrect    Boolean?
  feedback     String?

  @@unique([submissionId, questionId])
}
