generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// FOYDALANUVCHILAR VA AUTENTIFIKATSIYA
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  phone     String?  @unique  // Used as primary login identifier
  password  String
  name      String
  role      String   @default("ADMIN") // SUPER_ADMIN, ADMIN, MANAGER, TEACHER
  avatar    String?
  permissions String? @default("[]") // JSON array of permission keys
  isActive  Boolean  @default(true)
  telegramChatId String? @unique  // Staff bot Telegram chat ID
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taughtGroups   Group[]            @relation("TeacherGroups")
  enrollments    Enrollment[]
  journalEntries JournalEntry[]     @relation("TeacherJournal")
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@index([role, isActive])
  @@index([telegramChatId])
  @@index([deletedAt])
  @@index([createdAt])
}

// ============================================
// O'QUVCHILAR
// ============================================

model Student {
  id               String   @id @default(uuid())
  name             String
  phone            String?
  parentPhone      String?
  parentName       String?
  email            String?
  birthDate        String?
  address          String?
  photo            String?
  status           String   @default("active") // active, graduated, left
  source           String?  // Instagram, Telegram, etc.
  notes            String?
  telegramChatId   String?  // O'quvchining Telegram chat ID
  parentTelegramId String?  // Ota-onaning Telegram chat ID
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  enrollments       Enrollment[]
  payments          Payment[]
  attendanceRecords AttendanceRecord[]
  assessments       Assessment[]
  journalEntries    JournalEntry[]
  certificates      Certificate[]
  testSubmissions   TestSubmission[]

  @@index([phone])
  @@index([telegramChatId])
  @@index([status])
  @@index([source])
  @@index([deletedAt])
  @@index([createdAt])
}

// ============================================
// KURSLAR VA GURUHLAR
// ============================================

model Course {
  id             String   @id @default(uuid())
  name           String   // used by frontend
  title          String?  // alias/display title
  category       String?  @default("Boshqa")
  description    String?
  price          Float    @default(0)
  duration       String?  // "3 oy", "6 oy"
  lessonsPerWeek Int?     @default(3)
  lessonDuration Int?     @default(90)  // minutes
  status         String   @default("Active") // Active, Draft, Archived
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  groups        Group[]
  certificates  Certificate[]
  tests         Test[]

  @@index([category, status])
  @@index([status])
  @@index([deletedAt])
}

model Group {
  id          String   @id @default(uuid())
  name        String
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacherId   String?
  teacher     User?    @relation("TeacherGroups", fields: [teacherId], references: [id], onDelete: SetNull)
  status      String   @default("active")
  startDate   String?
  endDate     String?
  maxSize     Int      @default(20)
  room        String?
  days        String?
  time        String?
  price       Float?   @default(0)
  teacherName String?
  subject     String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments       Enrollment[]
  schedules         Schedule[]
  attendanceRecords AttendanceRecord[]
  journalEntries    JournalEntry[]
  tests             Test[]

  @@index([courseId, status])
  @@index([teacherId])
  @@index([status])
  @@index([deletedAt])
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  groupId   String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  startDate String?
  createdAt DateTime @default(now())

  @@unique([studentId, groupId])
  @@index([groupId])
  @@index([studentId])
}

// ============================================
// DARS JADVALI VA XONALAR
// ============================================

model Schedule {
  id        String @id @default(uuid())
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dayOfWeek Int    // 1-7 (Monday-Sunday)
  startTime String // "14:00"
  endTime   String // "16:00"
  roomId    String?
  room      Room?  @relation(fields: [roomId], references: [id])

  @@index([groupId])
  @@index([roomId, dayOfWeek])
  @@index([dayOfWeek, startTime])
}

model Room {
  id        String     @id @default(uuid())
  name      String
  capacity  Int        @default(30)
  color     String?    // UI uchun rang
  schedules Schedule[]
}

// ============================================
// DAVOMAT VA JURNAL
// ============================================

model AttendanceRecord {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date      String   // "2026-03-22"
  status    String   @default("present") // present, absent, late, excused
  checkIn   String?
  checkOut  String?
  note      String?
  createdAt DateTime @default(now())

  @@unique([studentId, groupId, date])
  @@index([groupId, date])
  @@index([studentId, date])
  @@index([status])
  @@index([date])
}

model JournalEntry {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation("TeacherJournal", fields: [teacherId], references: [id], onDelete: Cascade)
  date      String
  topic     String?
  homework  String?
  grade     Float?
  comment   String?
  createdAt DateTime @default(now())

  @@index([groupId, date])
  @@index([studentId, date])
  @@index([teacherId])
}

// ============================================
// BAHOLASH (ASSESSMENT)
// ============================================

model Assessment {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title     String   // "Mock Test #3", "Oylik Imtihon"
  type      String   @default("test") // test, exam, quiz, homework
  score     Float
  maxScore  Float    @default(100)
  date      String
  subject   String?
  notes     String?
  createdAt DateTime @default(now())
}

// ============================================
// MOLIYA (FINANCE)
// ============================================

model Transaction {
  id          String   @id @default(uuid())
  type        String   // income, expense
  amount      Float
  category    String   // "Kurs to'lovi", "Ijara", "Oylik", etc.
  description String?
  date        String
  method      String   @default("Naqd") // Naqd, Karta, Bank
  studentId   String?
  studentName String?
  staffId     String?
  staffName   String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, date])
  @@index([category])
  @@index([studentId])
  @@index([date])
  @@index([deletedAt])
}

model Payment {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("Naqd")
  date      String
  month     String?
  dueDate   String?
  status    String   @default("paid") // paid, pending, overdue
  notes     String?
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@index([studentId, status])
  @@index([dueDate, status])
  @@index([status])
  @@index([date])
  @@index([deletedAt])
}

// ============================================
// XODIMLAR (HR/STAFF)
// ============================================

model StaffMember {
  id         String   @id @default(uuid())
  name       String
  role       String   // "Direktor", "Administrator", "O'qituvchi"
  email      String?
  phone      String?
  salary     Float    @default(0)
  joinedDate String?
  status     String   @default("Faol") // Faol, Ta'tilda, Ishdan bo'shagan
  department String   @default("Ma'muriyat")
  address    String?
  passport   String?
  education  String?
  experience String?
  photo      String?
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  salaries        Salary[]
  attendances     StaffAttendance[]

  @@index([role])
  @@index([status])
  @@index([deletedAt])
}

// ============================================
// XODIM OYLIK TARIXI
// ============================================

model Salary {
  id          String   @id @default(uuid())
  staffId     String
  staff       StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  month       String   // "2026-05"
  baseSalary  Float    @default(0)
  bonus       Float    @default(0)
  deduction   Float    @default(0)
  total       Float    @default(0)
  paid        Boolean  @default(false)
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([staffId, month])
  @@index([staffId])
  @@index([month])
  @@index([paid])
}

// ============================================
// XODIM DAVOMATI
// ============================================

model StaffAttendance {
  id        String   @id @default(uuid())
  staffId   String
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  date      String   // "2026-05-21"
  checkIn   String?  // "09:00"
  checkOut  String?  // "18:00"
  status    String   @default("present") // present, absent, late, sick, vacation
  notes     String?
  createdAt DateTime @default(now())

  @@unique([staffId, date])
  @@index([staffId, date])
  @@index([date])
  @@index([status])
}

// ============================================
// LIDLAR (LEADS / VORONKA)
// ============================================

model Lead {
  id            String   @id @default(uuid())
  name          String
  phone         String
  email         String?
  stage         String   @default("new") // new, contacted, meeting, won, lost
  source        String?  // Instagram, Facebook, Telegram, etc.
  course        String?  // Qaysi kursga qiziqish
  score         Int      @default(0) // 0-100
  status        String   @default("warm") // hot, warm, cold
  date          String?
  notes         String?
  nextContactAt String?  // Follow-up scheduler
  assignedTo    String?  // userId
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  activities LeadActivity[]

  @@index([stage, status])
  @@index([source])
  @@index([phone])
  @@index([assignedTo])
  @@index([deletedAt])
  @@index([createdAt])
}

model LeadActivity {
  id      String @id @default(uuid())
  leadId  String
  lead    Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type    String // call, message, meeting, note
  content String
  date    String
  user    String @default("Admin")
}

// ============================================
// MARKETING
// ============================================

model Campaign {
  id        String   @id @default(uuid())
  name      String
  platform  String   // Instagram, Facebook, Telegram, Google
  budget    Float    @default(0)
  spent     Float    @default(0)
  leads     Int      @default(0)
  startDate String?
  endDate   String?
  status    String   @default("active") // active, paused, completed
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// INVENTAR
// ============================================

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  category    String   @default("Texnika") // Texnika, Mebel, O'quv qurollari
  quantity    Int      @default(1)
  threshold   Int      @default(0)        // Low stock alert threshold
  price       Float    @default(0)
  location    String?  // Xona nomi
  condition   String   @default("Yaxshi") // Yaxshi, O'rtacha, Yomon
  purchaseDate String?
  notes       String?
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions InventoryTransaction[]

  @@index([category])
  @@index([location])
  @@index([deletedAt])
}

// ============================================
// INVENTAR TRANZAKSIYALARI (kirim/chiqim)
// ============================================

model InventoryTransaction {
  id        String   @id @default(uuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String   // in, out, adjustment, damage
  quantity  Int
  reason    String?
  userId    String?
  userName  String?
  createdAt DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([type])
}

// ============================================
// KONTENT VA YANGILIKLAR (BLOG/NEWS)
// ============================================

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String?
  excerpt   String?
  imageUrl  String?
  author    String?
  status    String   @default("Faol") // Faol, Qoralama, Arxiv
  category  String   @default("Yangilik") // Yangilik, Blog, E'lon
  date      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// TARGET FORMALAR
// ============================================

model TargetForm {
  id          String   @id @default(uuid())
  title       String
  description String?
  course      String?
  url         String?  @unique // /l/formId
  isActive    Boolean  @default(true)
  submissions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// SOZLAMALAR
// ============================================

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

// ============================================
// BILDIRISHNOMALAR
// ============================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // info, alert, success, warning
  isRead    Boolean  @default(false)
  link      String?  // Optional click action
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

// ============================================
// GALEREYA (Landing page uchun)
// ============================================

model GalleryItem {
  id        String   @id @default(uuid())
  url       String
  title     String?
  date      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ============================================
// LANDING PAGE KONTENT (CMS)
// ============================================

model PageContent {
  id        String   @id @default(uuid())
  section   String   @unique // "hero", "stats", "programs", "testimonials", "cta"
  data      String   // JSON formatda
  updatedAt DateTime @updatedAt
}

// ============================================
// DYNAMIC DOCUMENTS (CMS / Fallback)
// ============================================

model GenericDocument {
  id         String   @id @default(uuid())
  collection String   // "teachers", "schedule", etc
  data       String   // JSON payload
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([collection])
}

// ============================================
// VAZIFALAR (ToDo)
// ============================================

model Task {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// TELEGRAM XABARLAR
// ============================================

model TelegramMessage {
  id        String   @id @default(uuid())
  chatId    String
  type      String   // attendance, payment, grade, schedule, lead, broadcast
  message   String
  status    String   @default("pending") // pending, sent, delivered, failed
  entityId  String?  // studentId, leadId, etc.
  error     String?
  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([type])
  @@index([status])
}

// ============================================
// AVTOMATIK WORKFLOWLAR
// ============================================

model Workflow {
  id          String    @id @default(uuid())
  name        String
  description String?
  trigger     String    // daily_payment, daily_attendance, hourly_leads, group_lifecycle
  isActive    Boolean   @default(true)
  config      String    @default("{}") // JSON: trigger-specific configuration
  lastRun     DateTime?
  nextRun     DateTime?
  runCount    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  logs WorkflowLog[]
}

model WorkflowLog {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status     String   // success, error, skipped
  output     String?  // JSON: execution details
  duration   Int?     // milliseconds
  createdAt  DateTime @default(now())

  @@index([workflowId])
  @@index([createdAt])
}

// ============================================
// HISOBOTLAR
// ============================================

model ReportTemplate {
  id          String   @id @default(uuid())
  name        String
  type        String   // financial, attendance, students, teachers
  config      String   @default("{}") // JSON: filters, columns
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String   // Snapshot of user's name at action time
  action     String   // create, update, delete, restore, login, logout
  resource   String   // student, group, payment, lead, ...
  resourceId String?
  before     String?  // JSON snapshot before change
  after      String?  // JSON snapshot after change
  ipAddress  String?
  userAgent  String?
  metadata   String?  // JSON extra context (reason, batch ID, etc.)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// SERTIFIKATLAR
// ============================================

model CertificateTemplate {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("certificate") // certificate, diploma, recognition
  background  String?  // Image URL
  config      String   @default("{\"elements\":[]}") // JSON layout
  width       Int      @default(842)
  height      Int      @default(595)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  certificates Certificate[]

  @@index([isActive])
  @@index([type])
}

model Certificate {
  id            String   @id @default(uuid())
  templateId    String
  template      CertificateTemplate @relation(fields: [templateId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  serialNumber  String   @unique // CRT-2026-0001
  issuedAt      DateTime @default(now())
  issuedBy      String?  // userId
  signature     String?  // Image URL
  qrCode        String?  // Verification URL
  pdfUrl        String?  // Generated PDF path
  grade         String?  // Grade or score on certificate
  metadata      String?  // JSON extra fields
  revokedAt     DateTime?
  revokedReason String?

  @@index([studentId])
  @@index([courseId])
  @@index([serialNumber])
  @@index([issuedAt])
}

// ============================================
// TEST/IMTIHON TIZIMI
// ============================================

model Test {
  id               String   @id @default(uuid())
  title            String
  description      String?
  courseId         String?
  course           Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  groupId          String?
  group            Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  duration         Int      @default(60) // minutes
  totalScore       Float    @default(100)
  passingScore     Float    @default(60)
  shuffleQuestions Boolean  @default(false)
  shuffleOptions   Boolean  @default(false)
  showResults      Boolean  @default(true)
  scheduledStart   String?
  scheduledEnd     String?
  status           String   @default("draft") // draft, published, closed
  createdBy        String?
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  questions   Question[]
  submissions TestSubmission[]

  @@index([courseId])
  @@index([groupId])
  @@index([status])
  @@index([createdBy])
  @@index([deletedAt])
}

model Question {
  id            String   @id @default(uuid())
  testId        String
  test          Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  order         Int      @default(0)
  type          String   // single_choice, multi_choice, true_false, short_answer, long_answer, fill_blank, matching
  text          String
  imageUrl      String?
  options       String   @default("[]") // JSON [{id, text, isCorrect}, ...]
  correctAnswer String?
  score         Float    @default(1)
  explanation   String?

  answers Answer[]

  @@index([testId, order])
}

model TestSubmission {
  id          String   @id @default(uuid())
  testId      String
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt   DateTime @default(now())
  submittedAt DateTime?
  score       Float?
  status      String   @default("in_progress") // in_progress, submitted, graded
  cheating    Boolean  @default(false)
  metadata    String?  // JSON: violations, timings

  answers Answer[]

  @@unique([testId, studentId])
  @@index([studentId])
  @@index([status])
}

model Answer {
  id           String   @id @default(uuid())
  submissionId String
  submission   TestSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value        String   // JSON: answer payload
  score        Float?
  isCorrect    Boolean?
  feedback     String?

  @@unique([submissionId, questionId])
}

// ============================================
// UY VAZIFASI
// ============================================

model HomeworkAssignment {
  id          String   @id @default(uuid())
  groupId     String
  title       String
  description String?
  dueDate     String?
  attachments String?  // JSON array of URLs
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions HomeworkSubmission[]

  @@index([groupId, dueDate])
}

model HomeworkSubmission {
  id           String   @id @default(uuid())
  assignmentId String
  assignment   HomeworkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  content      String?
  attachments  String?  // JSON
  submittedAt  DateTime @default(now())
  grade        Float?
  feedback     String?
  status       String   @default("submitted") // submitted, graded, late

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

