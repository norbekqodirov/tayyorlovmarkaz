generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ============================================
// FOYDALANUVCHILAR VA AUTENTIFIKATSIYA
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  phone     String?  @unique  // Used as primary login identifier
  password  String
  name      String
  role      String   @default("ADMIN") // SUPER_ADMIN, ADMIN, MANAGER, TEACHER
  avatar    String?
  permissions String? @default("[]") @db.Text // JSON array of permission keys
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taughtGroups   Group[]            @relation("TeacherGroups")
  enrollments    Enrollment[]
  journalEntries JournalEntry[]     @relation("TeacherJournal")
  notifications  Notification[]
}

// ============================================
// O'QUVCHILAR
// ============================================

model Student {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  parentPhone String?
  parentName  String?
  email       String?
  birthDate   String?
  address     String?
  photo       String?
  status      String   @default("active") // active, graduated, left
  source      String?  // Instagram, Telegram, etc.
  notes       String? @db.Text
  course      String?
  group       String?
  paymentStatus String?  @default("Kutilmoqda")
  balance       Float?   @default(0)
  joinedDate    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments       Enrollment[]
  payments          Payment[]
  attendanceRecords AttendanceRecord[]
  assessments       Assessment[]
  journalEntries    JournalEntry[]
  exams             Exam[]
  notesRelation     GroupStudentNote[]
  invoices          Invoice[]
  parents           Parent[]          @relation("StudentParent")
}

// ============================================
// KURSLAR VA GURUHLAR
// ============================================

model Course {
  id             String   @id @default(uuid())
  name           String   // used by frontend
  title          String?  // alias/display title
  category       String?  @default("Boshqa")
  description    String? @db.Text
  price          Float    @default(0)
  duration       String?  // "3 oy", "6 oy"
  lessonsPerWeek Int?     @default(3)
  lessonDuration Int?     @default(90)  // minutes
  status         String   @default("Active") // Active, Draft, Archived
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  groups Group[]
}

model Group {
  id        String   @id @default(uuid())
  name      String
  courseId   String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   User?    @relation("TeacherGroups", fields: [teacherId], references: [id], onDelete: SetNull)
  status    String   @default("active") // active, completed, paused
  startDate String?
  endDate   String?
  maxSize   Int      @default(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments       Enrollment[]
  schedules         Schedule[]
  attendanceRecords AttendanceRecord[]
  journalEntries    JournalEntry[]
  assessments       Assessment[]
  attendances       Attendance[]
  exams             Exam[]
  notes             GroupStudentNote[]
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  groupId   String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([studentId, groupId])
}

// ============================================
// DARS JADVALI VA XONALAR
// ============================================

model Schedule {
  id        String @id @default(uuid())
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dayOfWeek Int    // 1-7 (Monday-Sunday)
  startTime String // "14:00"
  endTime   String // "16:00"
  roomId    String?
  room      Room?  @relation(fields: [roomId], references: [id])
}

model Room {
  id        String     @id @default(uuid())
  name      String
  capacity  Int        @default(30)
  color     String?    // UI uchun rang
  schedules Schedule[]
}

// ============================================
// DAVOMAT VA JURNAL
// ============================================

model AttendanceRecord {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date      String   // "2026-03-22"
  status    String   @default("present") // present, absent, late, excused
  checkIn   String?
  checkOut  String?
  note      String?
  createdAt DateTime @default(now())

  @@unique([studentId, groupId, date])
}

model JournalEntry {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation("TeacherJournal", fields: [teacherId], references: [id], onDelete: Cascade)
  date      String
  topic     String?
  homework  String?
  grade     Float?
  comment   String?
  createdAt DateTime @default(now())
}

// ============================================
// BAHOLASH (ASSESSMENT)
// ============================================

model Assessment {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title     String?   // "Mock Test #3", "Oylik Imtihon"
  type      String   @default("test") // test, exam, quiz, homework
  score     Float
  maxScore  Float    @default(100)
  date      String
  subject   String?
  notes     String? @db.Text
  createdAt DateTime @default(now())
}

// ============================================
// MOLIYA (FINANCE)
// ============================================

model Transaction {
  id          String   @id @default(uuid())
  type        String   // income, expense
  amount      Float
  category    String   // "Kurs to'lovi", "Ijara", "Oylik", etc.
  description String?
  date        String
  method      String   @default("Naqd") // Naqd, Karta, Bank
  studentId   String?
  studentName String?
  staffId     String?
  staffName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("Naqd")
  date      String
  month     String?
  dueDate   String?
  status    String   @default("paid") // paid, pending, overdue
  notes     String?
  createdAt DateTime @default(now())
}

// ============================================
// XODIMLAR (HR/STAFF)
// ============================================

model StaffMember {
  id         String   @id @default(uuid())
  name       String
  role       String   // "Direktor", "Administrator", "O'qituvchi"
  email      String?
  phone      String?
  salary     Float    @default(0)
  joinedDate String?
  status     String   @default("Faol") // Faol, Ta'tilda, Ishdan bo'shagan
  department String   @default("Ma'muriyat")
  address    String?
  passport   String?
  education  String?
  experience String?
  photo      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============================================
// LIDLAR (LEADS / VORONKA)
// ============================================

model Lead {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  stage     String   @default("new") // new, contacted, meeting, won, lost
  source    String?  // Instagram, Facebook, Telegram, etc.
  course    String?  // Qaysi kursga qiziqish
  score     Int      @default(0) // 0-100
  status    String   @default("warm") // hot, warm, cold
  date      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities LeadActivity[]
}

model LeadActivity {
  id      String @id @default(uuid())
  leadId  String
  lead    Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type    String // call, message, meeting, note
  content String
  date    String
  user    String @default("Admin")
}

// ============================================
// MARKETING
// ============================================

model Campaign {
  id        String   @id @default(uuid())
  name      String
  platform  String   // Instagram, Facebook, Telegram, Google
  budget    Float    @default(0)
  spent     Float    @default(0)
  leads     Int      @default(0)
  startDate String?
  endDate   String?
  status    String   @default("active") // active, paused, completed
  notes     String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// INVENTAR
// ============================================

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  category    String   @default("Texnika") // Texnika, Mebel, O'quv qurollari
  quantity    Int      @default(1)
  price       Float    @default(0)
  location    String?  // Xona nomi
  condition   String   @default("Yaxshi") // Yaxshi, O'rtacha, Yomon
  purchaseDate String?
  notes       String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// KONTENT VA YANGILIKLAR (BLOG/NEWS)
// ============================================

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String? @db.Text
  excerpt   String? @db.Text
  imageUrl  String?
  author    String?
  status    String   @default("Faol") // Faol, Qoralama, Arxiv
  category  String   @default("Yangilik") // Yangilik, Blog, E'lon
  date      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// TARGET FORMALAR
// ============================================

model TargetForm {
  id          String   @id @default(uuid())
  title       String
  description String?
  course      String?
  url         String?  @unique // /l/formId
  isActive    Boolean  @default(true)
  submissions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// SOZLAMALAR
// ============================================

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

// ============================================
// BILDIRISHNOMALAR
// ============================================

model Notification {
  id        String   @id @default(uuid())
  userId    String?  // Optional: null = system notification (broadcast)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // info, alert, success, warning
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================
// GALEREYA (Landing page uchun)
// ============================================

model GalleryItem {
  id        String   @id @default(uuid())
  url       String
  title     String?
  date      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

// ============================================
// LANDING PAGE KONTENT (CMS)
// ============================================

model PageContent {
  id        String   @id @default(uuid())
  section   String   @unique // "hero", "stats", "programs", "testimonials", "cta"
  data      String   @db.Text // JSON formatda
  updatedAt DateTime @updatedAt
}

// ============================================
// DYNAMIC DOCUMENTS (CMS / Fallback)
// ============================================

model GenericDocument {
  id         String   @id @default(uuid())
  collection String   // "teachers", "schedule", etc
  data       String   @db.Text // JSON payload
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([collection])
}

// ============================================
// VAZIFALAR (ToDo)
// ============================================

model Task {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// NEW ACADEMIC MODELS (Faza 0.2 Generic Clean)
// ============================================

model GroupSchedule {
  id         String   @id @default(uuid())
  groupId    String
  groupName  String
  teacher    String
  room       String
  startTime  String
  endTime    String
  days       String   @db.Text // JSON representation of days (number[])
  color      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Attendance {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date      String   // "2026-03-22"
  records   String   @db.Text // JSON representation of records (studentId, status, time)[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, date])
}

model Exam {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examName  String
  score     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, studentId, examName])
}

model GroupStudentNote {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  note      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, studentId])
}

model OnlineTransaction {
  id            String    @id @default(uuid())
  provider      String    // "payme" or "click"
  transactionId String    @unique // provider's transaction ID (e.g. click_trans_id or payme's _id)
  amount        Float
  studentId     String
  state         Int       // For payme: 1 = created, 2 = performed, -1 = canceled, -2 = canceled after perform. For click: 0 = prepare, 1 = complete, 2 = cancel.
  reason        Int?      // cancellation reason code
  createdAt     DateTime  @default(now())
  performAt     DateTime?
  cancelAt      DateTime?
}

// ============================================
// FAZA 1.1 — KENGAYTIRILGAN MOLIYA MODELLARI
// ============================================

model Invoice {
  id          String        @id @default(uuid())
  number      String        @unique // INV-2025-0001
  studentId   String
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Float
  discount    Float         @default(0)
  tax         Float         @default(0)
  status      String        @default("pending") // pending, paid, overdue, cancelled
  dueDate     String
  paidAt      DateTime?
  method      String?       // Naqd, Payme, Click, Bank, Karta
  description String?       @db.Text
  items       InvoiceItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name      String
  quantity  Int     @default(1)
  price     Float
}

model Expense {
  id          String   @id @default(uuid())
  category    String   // SALARY, RENT, UTILITIES, SUPPLIES, MARKETING, EQUIPMENT, OTHER
  amount      Float
  description String   @db.Text
  date        String
  receipt     String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Budget {
  id       String @id @default(uuid())
  month    Int
  year     Int
  category String
  planned  Float
  actual   Float  @default(0)

  @@unique([month, year, category])
}

// ============================================
// FAZA 1.3 — ALOQA MARKAZI MODELLARI
// ============================================

model MessageTemplate {
  id        String   @id @default(uuid())
  name      String
  content   String   @db.Text // {{student_name}}, {{amount}}, {{date}} o'zgaruvchilar
  type      String   @default("CUSTOM") // PAYMENT_REMINDER, LESSON_REMINDER, WELCOME, BIRTHDAY, ANNOUNCEMENT, RESULT, CUSTOM
  language  String   @default("uz")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BulkMessage {
  id         String   @id @default(uuid())
  templateId String?
  content    String   @db.Text
  targetType String   // "group", "course", "all", "debtors", "leads"
  targetId   String?
  sentAt     DateTime?
  sentCount  Int      @default(0)
  status     String   @default("draft") // draft, sent, failed
  createdAt  DateTime @default(now())
}

// ============================================
// FAZA 1.4 — OTA-ONA MODELI
// ============================================

model Parent {
  id         String    @id @default(uuid())
  name       String
  phone      String
  telegramId String?
  createdAt  DateTime  @default(now())
  children   Student[] @relation("StudentParent")
}

// ============================================
// FAZA 3 — TEST TIZIMI
// ============================================

model Quiz {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  courseId    String?
  groupId     String?
  duration    Int          @default(30) // daqiqada
  maxScore    Int          @default(100)
  passingScore Int         @default(60)
  isPublic    Boolean      @default(false) // lid uchun ochiq test
  publicSlug  String?      @unique        // /test/<slug>
  status      String       @default("draft") // draft, active, archived
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  questions   QuizQuestion[]
  attempts    QuizAttempt[]
}

model QuizQuestion {
  id        String         @id @default(uuid())
  quizId    String
  quiz      Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text      String         @db.Text
  type      String         @default("single") // single, multiple, text
  order     Int            @default(0)
  points    Int            @default(1)
  imageUrl  String?
  options   QuizOption[]
  answers   QuizAnswer[]
}

model QuizOption {
  id         String       @id @default(uuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean      @default(false)
  order      Int          @default(0)
}

model QuizAttempt {
  id          String       @id @default(uuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId   String?      // null = anonim (lid)
  studentName String?      // anonim uchun
  studentPhone String?     // anonim uchun
  score       Float        @default(0)
  maxScore    Float        @default(0)
  passed      Boolean      @default(false)
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  timeSpent   Int?         // soniyada
  answers     QuizAnswer[]
}

model QuizAnswer {
  id          String       @id @default(uuid())
  attemptId   String
  attempt     QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptions String   @db.Text // JSON: option ID lari ro'yxati
  textAnswer  String?      @db.Text
  isCorrect   Boolean      @default(false)
  points      Float        @default(0)
}

// ============================================
// FAZA 5.3 — KPI VA MAQSADLAR
// ============================================

model Goal {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  type        String   // revenue, students, leads, attendance, conversion
  target      Float
  current     Float    @default(0)
  unit        String   @default("ta") // ta, so'm, %
  period      String   // monthly, quarterly, yearly
  month       Int?
  year        Int
  assignedTo  String?  // userId
  status      String   @default("active") // active, completed, failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
