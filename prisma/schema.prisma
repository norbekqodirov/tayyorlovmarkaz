generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ============================================
// FOYDALANUVCHILAR VA AUTENTIFIKATSIYA
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  phone     String?  @unique  // Used as primary login identifier
  password  String
  name      String
  role      String   @default("ADMIN") // SUPER_ADMIN, ADMIN, MANAGER, TEACHER — ESKI, saqlanadi
  roleId    String?  // YANGI (2026-09-12) — Role jadvaliga FK, migratsiya to'ldiradi
  roleRef   Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  avatar    String?
  permissions String? @default("[]") @db.Text // JSON array of permission keys
  subject     String?  // O'qituvchi uchun: fan nomi
  experience  String?  // O'qituvchi uchun: tajriba (masalan "5 yil")
  bio         String?  @db.Text // O'qituvchi uchun: tavsif
  salaryPercent Float? // O'qituvchi uchun shaxsiy oylik foiz stavkasi — bo'sh
                        // bo'lsa global 'teacher_salary_percent' sozlamasi ishlatiladi
  isActive       Boolean  @default(true)
  telegramChatId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  taughtGroups   Group[]            @relation("TeacherGroups")
  enrollments    Enrollment[]
  journalEntries JournalEntry[]     @relation("TeacherJournal")
  notifications  Notification[]
  auditLogs      AuditLog[]
  leadsOwned     Lead[]             @relation("LeadOwner")
  leadActivities LeadActivity[]
  permissionOverrides        PermissionOverride[] @relation("PermissionOverrides")
  grantedPermissionOverrides PermissionOverride[] @relation("PermissionOverridesGranted")
  teacherPayrolls            TeacherPayroll[]
}

// Finance-audit (2026-09-15), F4: o'qituvchi oyligi — Salary (StaffMember uchun)
// bilan bir xil naqsh, lekin User (teacher)ga to'g'ridan-to'g'ri bog'langan
// (RF-06: ilgari User↔StaffMember orasida hech qanday canonical bog'lanish
// yo'q edi, teacher payroll esa umuman alohida, tasdiqlanmagan yo'l — HR
// kartasidagi "to'lash" oddiy generic xarajat yaratardi). "paid" holatidan
// chiqish yoki qayta yozish TAQIQLANADI (Salary'dagi RF-05 bilan bir xil
// himoya) — tuzatish kerak bo'lsa alohida (hali qo'shilmagan) adjustment
// jarayoni kerak bo'ladi.
model TeacherPayroll {
  id             String    @id @default(uuid())
  teacherId      String
  teacher        User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  month          String    // "2026-09"
  basis          String    // "accrual" | "cash"
  accruedAmount  Float     // Tasdiqlangunga qadar qayta hisoblanishi mumkin
  paidAmount     Float     @default(0)
  // Payroll-avans (2026-09-17): tasdiqlash vaqtida shu xodimning OLDINDAN
  // (StaffAdvance) berilgan, hali qoplanmagan summasidan avtomatik qoplangan
  // qism — "berilgan" (paidAmount, keyingi qo'lda to'lovlar) dan ALOHIDA
  // ko'rsatiladi, chunki bu pul allaqachon avans sifatida berib bo'lingan,
  // endi shunchaki QAYSI davr hisobiga o'tkazilgani belgilanmoqda.
  advanceApplied Float     @default(0)
  status         String    @default("draft") // draft | approved | paid
  sourceSnapshot String?   @db.Text // JSON — hisoblangan paytdagi breakdown (audit uchun)
  notes          String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lines          PayrollLine[]

  @@unique([teacherId, month, basis])
}

// IP-15 (TQ-B): e'lon qilingan hisobdan ustoz maoshi qatori — "bu summa qaysi o'quvchi
// hisobidan" izi. Bir hisob bir maoshga faqat bir marta kiradi (payrollId+chargeId unique).
model PayrollLine {
  id         String         @id @default(uuid())
  payrollId  String
  payroll    TeacherPayroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  chargeId   String
  studentId  String
  groupId    String?
  baseAmount Int // hisob ustoz bazasi × ulush
  shareNum   Int // ustoz o'tgan billable darslar
  shareDen   Int // jami billable darslar
  rateBp     Int
  amount     Int

  @@unique([payrollId, chargeId])
  @@index([chargeId])
}

// IP-15 (OQ-10): tasdiqlangandan keyingi maosh tuzatmasi — keyingi ochiq oy maoshiga qo'shiladi
model PayrollAdjustment {
  id          String   @id @default(uuid())
  personType  String // teacher | staff
  personId    String
  month       String // qaysi oyning maoshiga qo'shiladi
  amount      Int // ishorali
  reason      String
  sourceType  String? // charge_adjustment | refund | manual
  sourceId    String?
  appliedToId String? // qaysi TeacherPayroll/Salary'ga kirdi
  createdById String?
  createdAt   DateTime @default(now())

  @@index([personType, personId, month])
}

// Payroll-avans tizimi (2026-09-17, foydalanuvchi so'rovi): "oylik
// hisoblanishi — berilishi degani emas; xodim oldindan avans olishi mumkin".
// Bitta umumiy jadval HAM o'qituvchi (personType="teacher", personId=User.id)
// HAM boshqa xodim (personType="staff", personId=StaffMember.id) uchun —
// avans shaxsga tegishli, muayyan oyga emas (oy tasdiqlanganda avtomatik
// eng eski avansdan boshlab qoplanadi, FIFO).
model StaffAdvance {
  id          String   @id @default(uuid())
  personType  String   // "teacher" | "staff"
  personId    String
  amount      Float    // berilgan asl summa
  remaining   Float    // hali qoplanmagan qoldiq (amount'dan boshlanadi, qoplangan sari kamayadi)
  date        String
  method      String   @default("Naqd")
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())

  applications StaffAdvanceApplication[]

  @@index([personType, personId])
}

// Bitta avans BIR NECHTA davrga bo'lib qoplanishi mumkin (agar avans
// bitta oylikdan katta bo'lsa) — shuning uchun qoplash alohida, ko'p
// yozuvli jadvalda: "qaysi avansdan, qanchasi, qaysi oylik/maosh yozuviga
// o'tkazilgani" har doim orqaga qarab tekshirilishi mumkin.
model StaffAdvanceApplication {
  id            String       @id @default(uuid())
  advanceId     String
  advance       StaffAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  amount        Float
  appliedToType String       // "teacher_payroll" | "salary"
  appliedToId   String
  createdAt     DateTime     @default(now())

  @@index([appliedToType, appliedToId])
}

// ============================================
// O'QUVCHILAR
// ============================================

model Student {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  parentPhone String?
  parentName  String?
  email       String?
  birthDate   String?
  address     String?
  photo       String?
  status      String   @default("active") // active, graduated, left
  deletedAt   DateTime?
  source      String?  // Instagram, Telegram, etc.
  notes            String? @db.Text
  course           String?
  group            String?
  paymentStatus    String?  @default("Kutilmoqda")
  balance          Float?   @default(0)
  joinedDate       String?
  telegramChatId   String?
  parentTelegramId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branchId         String?
  // IP-09 (TQ-D): o'quvchi kodi (S-000001) va qidiruv/dublikat uchun normallashgan telefon (oxirgi 9 raqam).
  // `code` noyobligini ilova ta'minlaydi (server/services/studentIdentity.ts — atomar hisoblagich):
  // mavjud jadvalga unique qo'shish production'da `db push`ni --accept-data-loss'siz to'xtatardi (J.6).
  code             String?
  phoneNorm        String?
  enrollments       Enrollment[]
  enrollmentPeriods EnrollmentPeriod[]
  charges           Charge[]
  studentDiscounts  StudentDiscount[]
  payments          Payment[]
  attendanceRecords AttendanceRecord[]
  assessments       Assessment[]
  journalEntries    JournalEntry[]
  exams             Exam[]
  notesRelation     GroupStudentNote[]
  invoices          Invoice[]
  parents           Parent[]          @relation("StudentParent")
  certificates      Certificate[]
  testSubmissions   TestSubmission[]
  leads             Lead[]
  lessonAttendance  LessonAttendance[]

  @@index([code])
  @@index([phoneNorm])
}

// ============================================
// KURSLAR VA GURUHLAR
// ============================================

model Course {
  id             String   @id @default(uuid())
  name           String   // used by frontend
  title          String?  // alias/display title
  category       String?  @default("Boshqa")
  description    String? @db.Text
  price          Float    @default(0)
  duration       String?  // "3 oy", "6 oy"
  lessonsPerWeek Int?     @default(3)
  lessonDuration Int?     @default(90)  // minutes
  status         String   @default("Active") // Active, Draft, Archived
  image          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  groups       Group[]
  certificates Certificate[]
  levels       CourseLevel[]
  tests        Test[]
  tiers        CourseTier[]
}

// Bitta kurs ichida bir nechta narx tarifi (masalan "2-sinf", "3-sinf" —
// har biri o'z narxiga ega). Kurs yaratish/tahrirlash formasida boshqariladi.
model CourseTier {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name      String   // "2-sinf", "Standart", "VIP" va h.k.
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Group {
  id        String   @id @default(uuid())
  name      String
  courseId   String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   User?    @relation("TeacherGroups", fields: [teacherId], references: [id], onDelete: SetNull)
  status    String   @default("active") // active, completed, paused
  deletedAt DateTime?
  branchId  String?
  startDate String?
  endDate   String?
  maxSize   Int      @default(20)
  price     Float?   // Shu guruhga xos narx (masalan sinf bo'yicha tarif) — bo'sh bo'lsa Course.price ishlatiladi
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments       Enrollment[]
  schedules         Schedule[]
  attendanceRecords AttendanceRecord[]
  journalEntries    JournalEntry[]
  assessments       Assessment[]
  attendances       Attendance[]
  exams             Exam[]
  groupExams        GroupExam[]
  notes             GroupStudentNote[]
  tests             Test[]
  lessonSessions    LessonSession[]
  enrollmentPeriods  EnrollmentPeriod[]
  tariffVersions     TariffVersion[]
  teacherAssignments GroupTeacherAssignment[]
}

// Enrollment — o'quvchining guruhdagi JORIY a'zoligi (kesh). A'zolik tarixi
// va sanalari — EnrollmentPeriod (IP-09); davr tugaganda Enrollment qatori
// o'chiriladi, davr esa tarix sifatida qoladi.
model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  groupId   String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([studentId, groupId])
}

// ============================================
// A'ZOLIK DAVRLARI VA TARIXLAR (IP-09)
// docs/ADR_HISOB_QOIDALARI.md, server/services/enrollment.ts
// Sanalar — "YYYY-MM-DD" (Toshkent), pul — butun so'm (Int)
// ============================================

model EnrollmentPeriod {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId        String
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  startDate      String   // birinchi billable kun (OQ-02: shu kungi dars hisoblanadi)
  endDate        String?  // oxirgi kun; null — davom etmoqda
  status         String   @default("active") // active | ended
  endReason      String?  // left | transfer | graduated | admin_fix | unknown
  startSource    String   @default("manual") // manual | lead_convert | import | transfer | legacy_api | backfill_attendance | backfill_created
  endSource      String?  // manual | transfer | legacy_api | backfill_attendance
  transferFromId String?  // oldingi davr (transfer)
  note           String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pauses EnrollmentPause[]

  @@index([studentId])
  @@index([groupId, status])
}

model EnrollmentPause {
  id          String           @id @default(uuid())
  periodId    String
  period      EnrollmentPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  fromDate    String
  toDate      String           // OQ-06: 7–60 kun, doim chegaralangan
  reason      String
  status      String           @default("active") // active | cancelled
  createdById String?
  createdAt   DateTime         @default(now())

  @@index([periodId])
}

// Guruh tarifi tarixi (OQ-01). Group.price — joriy versiyaning keshi.
model TariffVersion {
  id                String   @id @default(uuid())
  groupId           String
  group             Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  monthlyPrice      Int
  lessonsPerPackage Int      @default(12)
  pricingMode       String   @default("fixed_package") // fixed_package
  effectiveFrom     String
  effectiveTo       String?
  source            String   @default("manual") // manual | legacy_edit | group_create | backfill
  createdById       String?
  createdAt         DateTime @default(now())

  @@index([groupId, effectiveFrom])
}

// Guruh ustozi tarixi (OQ-11). Group.teacherId — joriy tayinlashning keshi.
// teacherId ataylab FK emas: foydalanuvchi o'chirilsa ham tarix saqlanadi.
model GroupTeacherAssignment {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacherId   String
  fromDate    String
  toDate      String?
  role        String   @default("primary") // primary | substitute
  source      String   @default("manual")
  createdById String?
  createdAt   DateTime @default(now())

  @@index([groupId, fromDate])
  @@index([teacherId])
}

// Ustoz foizi tarixi (TQ-B). User.salaryPercent — joriy stavkaning keshi.
model TeacherRate {
  id            String   @id @default(uuid())
  teacherId     String
  rateBp        Int      // 4000 = 40,00%
  basis         String   @default("accrual")
  effectiveFrom String
  effectiveTo   String?
  source        String   @default("manual")
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([teacherId, effectiveFrom])
}

// ============================================
// O'QUVCHI HISOBLARI (IP-11) — docs/ADR_HISOB_QOIDALARI.md, server/services/chargeEngine.ts
// Hisob (majburiyat) guruh×oy bo'yicha; e'lon qilingani o'zgarmaydi — faqat tuzatma hisobi.
// ============================================

model BillingPeriod {
  id           String    @id @default(uuid())
  month        String    @unique // "2026-11"
  status       String    @default("open") // open | closing | closed
  closedAt     DateTime?
  closedById   String?
  checklist    String? // JSON natija
  reopenedAt   DateTime?
  reopenReason String?
  createdAt    DateTime  @default(now())
}

model Charge {
  id                 String       @id @default(uuid())
  chargeKey          String       @unique // "T:{periodId}:{YYYY-MM}" | "S:{chargeId}:{n}" | "A:{chargeId}:{uuid}" | "O:{studentId}:{groupId}"
  studentId          String
  student            Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId            String?
  enrollmentPeriodId String?
  month              String // xizmat oyi
  type               String // tuition | adjustment | opening_balance | other_fee
  status             String       @default("draft") // draft | posted | void
  gross              Int
  net                Int
  teacherBase        Int          @default(0) // OQ-05: ustoz maosh bazasi (marketing chegirmalarisiz)
  dueDate            String?
  teacherId          String? // asosiy ustoz (ko'rsatish uchun)
  calc               String?      @db.Text // JSON: P, N, R, F, A, M, tarif/stavka, sanalar, ustoz darslari
  reversesChargeId   String? // tuzatma qaysi hisobga
  reason             String?
  postedAt           DateTime?
  postedById         String?
  createdById        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  lines              ChargeLine[]
  allocations        PaymentAllocation[]

  @@index([studentId, month])
  @@index([groupId, month])
  @@index([status, month])
  @@index([reversesChargeId])
}

model ChargeLine {
  id          String  @id @default(uuid())
  chargeId    String
  charge      Charge  @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  kind        String // base | extra_lesson | absence_discount | cancel_credit | promo | sibling | social | manual
  amount      Int // ishorali: baza musbat, chegirma manfiy
  description String
  sourceId    String? // StudentDiscount.id, LessonSession.id va h.k.

  @@index([chargeId])
}

// Takrorlanuvchi chegirma (aka-uka, ijtimoiy, grant) — hisob generatsiyasida ChargeLine bo'ladi (OQ-05 tartibi)
model StudentDiscount {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId     String? // null — o'quvchining barcha guruhlariga
  kind        String // sibling | social | promo | manual
  percentBp   Int? // 1000 = 10% (qolgan summaga)
  amount      Int? // yoki qat'iy summa
  fromMonth   String // "YYYY-MM"
  toMonth     String? // null — muddatsiz
  reason      String
  discountId  String? // promo-kod manbai (Discount)
  status      String   @default("active") // active | cancelled
  createdById String?
  createdAt   DateTime @default(now())

  @@index([studentId])
}

// ============================================
// DARS JADVALI VA XONALAR
// ============================================

model Schedule {
  id        String @id @default(uuid())
  groupId   String
  group     Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dayOfWeek Int    // 1-7 (Monday-Sunday)
  startTime String // "14:00"
  endTime   String // "16:00"
  roomId    String?
  room      Room?  @relation(fields: [roomId], references: [id])
}

model Room {
  id        String     @id @default(uuid())
  name      String
  capacity  Int        @default(30)
  color     String?    // UI uchun rang
  schedules Schedule[]
}

// ============================================
// DAVOMAT VA JURNAL
// ============================================

model AttendanceRecord {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date      String   // "2026-03-22"
  status    String   @default("present") // present, absent, late, excused
  checkIn   String?
  checkOut  String?
  note      String?
  createdAt DateTime @default(now())
  // IP-10 (TL-07): kim va qachon belgilagan; kechikkan tuzatish sababi; rejadagi dars
  markedById String?
  markedAt   DateTime?
  editReason String?
  sessionId  String?

  @@unique([studentId, groupId, date])
}

// IP-10 (OQ-03): markaz bayramlari — rejadagi darslar bu kunlarga yaratilmaydi
model Holiday {
  id          String   @id @default(uuid())
  date        String   @unique // "YYYY-MM-DD"
  name        String
  createdById String?
  createdAt   DateTime @default(now())
}

// EDU-06: guruh bir kunda bir necha marta o'tilishi mumkin (qo'shimcha/qoplash
// darsi) — lekin AttendanceRecord'ning yuqoridagi (studentId,groupId,date)
// yagona kaliti buni qo'llab-quvvatlamaydi (kundagi ikkinchi dars uchun
// yozuv yozib bo'lmaydi). Bu ataylab ALOHIDA, qo'shimcha jadval sifatida
// qilindi — AttendanceRecord va uni o'qiydigan barcha joylar (billing,
// scheduler, analytics, bot, portal) o'zgarishsiz qoladi (standart,
// kundalik yagona dars holati uchun hech qanday xavf yo'q); faqat haqiqatan
// bir kunda ikkinchi darsi bo'lgan (kamdan-kam) holatlar uchun o'qituvchi
// LessonSession yaratib, unga alohida davomat yozadi.
model LessonSession {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  date      String   // "2026-03-22" — asosiy darsning O'ZI ham shu kunga to'g'ri keladi
  startTime String?  // "14:00" — bir nechta qo'shimcha dars bo'lsa ajratish uchun
  label     String?  // masalan "Qoplash darsi", "2-smena"
  createdAt DateTime @default(now())
  // IP-10 (TL-09, OQ-03): dars rejasi. Eski yozuvlarda kind = null — ular qo'shimcha darslar.
  kind              String?  // regular | extra | makeup | trial
  status            String?  // planned | held | cancelled | moved
  billable          Boolean? // pullik darsmi (R hisobiga kiradimi)
  price             Int?     // pullik qo'shimcha dars narxi (extra_lesson qatori)
  teacherId         String?  // darsni o'tadigan/o'tgan ustoz
  replacesSessionId String?  // ko'chirilgan yoki qoplanayotgan dars
  cancelReason      String?  // center | teacher | holiday | other
  compensate        Boolean? // bekor qilingan va qoplanmagan dars uchun kredit (P/N)
  createdById       String?

  attendance LessonAttendance[]

  @@index([groupId, date])
}

model LessonAttendance {
  id        String        @id @default(uuid())
  sessionId String
  session   LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status    String        @default("present") // present, absent, late, excused
  note      String?
  createdAt DateTime      @default(now())

  @@unique([sessionId, studentId])
}

model JournalEntry {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation("TeacherJournal", fields: [teacherId], references: [id], onDelete: Cascade)
  date      String
  topic     String?
  homework  String?
  grade     Float?
  comment   String?
  createdAt DateTime @default(now())
}

// ============================================
// BAHOLASH (ASSESSMENT)
// ============================================

model Assessment {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title     String?   // "Mock Test #3", "Oylik Imtihon"
  type      String   @default("test") // test, exam, quiz, homework
  score     Float
  maxScore  Float    @default(100)
  date      String
  subject   String?
  notes     String? @db.Text
  createdAt DateTime @default(now())
}

// ============================================
// MOLIYA (FINANCE)
// ============================================

model Transaction {
  id          String   @id @default(uuid())
  type        String   // income, expense
  amount      Float
  category    String   // "Kurs to'lovi", "Ijara", "Oylik", etc.
  description String?
  date        String
  method      String   @default("Naqd") // Naqd, Karta, Bank
  studentId   String?
  studentName String?
  staffId     String?
  staffName   String?
  // Finance-audit (2026-09-15), F2: qaysi domen hodisasi bu yozuvni
  // yaratgani (masalan "teacher_payroll"/"<TeacherPayroll.id>") — hozircha
  // faqat YANGI yozish yo'llarida (masalan teacher payroll payout)
  // to'ldiriladi, eski yozuvlarda null qoladi (additive, orqaga qarab
  // to'ldirilmaydi).
  sourceType  String?
  sourceId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("Naqd")
  date      String
  month     String?
  dueDate   String?
  status    String   @default("paid") // paid, pending, overdue, refunded
  notes     String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  // Finance-audit (2026-09-16), F07: qaysi domen hodisasi (masalan
  // "online_transaction"/OnlineTransaction.id) bu Payment'ni yaratgani —
  // Transaction.sourceType/sourceId bilan bir xil naqsh. Payme/Click orqali
  // kelgan to'lov keyinchalik bekor qilinsa (Payme CancelTransaction),
  // aynan shu Payment yozuvini topib status='refunded' qilish uchun kerak —
  // bo'lmasa "paid" Payment abadiy noto'g'ri ko'rinib qolardi.
  sourceType String?
  sourceId   String?
  // IP-12 (TQ-D): kvitansiya — raqam (ilova ketma-ketligi, unique emas), taqsimot rejimi, qabul qilgan
  receiptNo      String?
  allocationMode String? // legacy | manual | auto_fifo (null — IP-12 dan oldingi)
  receivedById   String?
  groupId        String? // to'lov qaysi guruh uchun (taklif; aniq biriktirish — PaymentAllocation)

  allocations PaymentAllocation[]
}

// IP-12: to'lovning qaysi hisobni qancha yopgani. Bekor qilish — reversedAt (o'chirilmaydi).
model PaymentAllocation {
  id            String    @id @default(uuid())
  paymentId     String
  payment       Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  chargeId      String
  charge        Charge    @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  amount        Int
  createdById   String?
  createdAt     DateTime  @default(now())
  reversedAt    DateTime?
  reversedById  String?
  reverseReason String?

  @@index([paymentId])
  @@index([chargeId])
}

// IP-12: pul komandalari idempotentligi (Idempotency-Key sarlavhasi) — bir kalit bilan
// takroriy so'rov bir marta bajariladi, keyingilari saqlangan javobni oladi.
model IdempotencyRecord {
  key          String   @id
  userId       String?
  route        String
  requestHash  String
  statusCode   Int // 0 — bajarilmoqda
  responseBody String?  @db.Text
  createdAt    DateTime @default(now())
}

// ============================================
// XODIMLAR (HR/STAFF)
// ============================================

model StaffMember {
  id         String   @id @default(uuid())
  name       String
  role       String   // "Direktor", "Administrator", "O'qituvchi" — erkin matn (eski, mos kelish uchun saqlanadi)
  positionId String?  // Agar tuzilgan Lavozim tanlangan bo'lsa (ixtiyoriy — eski yozuvlarda yo'q)
  email      String?
  phone      String?
  salary     Float    @default(0)
  joinedDate String?
  status     String   @default("Faol") // Faol, Ta'tilda, Ishdan bo'shagan
  deletedAt  DateTime?
  department   String   @default("Ma'muriyat") // ESKI erkin matn, saqlanadi
  departmentId String?  // YANGI (2026-09-12) — Department jadvaliga FK
  address    String?
  passport   String?
  education  String?
  experience String?
  photo          String?
  branchId       String?
  telegramChatId String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  position         Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  departmentRef    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  salaries         Salary[]
  staffAttendances StaffAttendance[]
  leaveRequests    LeaveRequest[]
  faceProfile      StaffFaceProfile?
  tasks             Task[]
  performanceReviews PerformanceReview[]
  documents         StaffDocument[]
}

// Lavozim — xodim qo'shishdan oldin tashkil qilinadigan andoza: nomi,
// yo'riqnoma/vazifalar va shu lavozim uchun standart ruxsatlar. StaffMember
// yaratishda tanlansa, login (User) ochilganda shu yerdagi standart rol/
// ruxsatlar ishlatiladi (requester o'z rolidan yuqorisini bera olmaydi —
// server/routes/crud.ts'dagi ensureStaffLoginAccount()ga q.).
model Position {
  id                 String   @id @default(uuid())
  name               String   @unique
  description        String?  @db.Text // Yo'riqnoma
  responsibilities   String?  @db.Text // Vazifalar
  // ESKI (RBAC qayta qurishdan oldingi) andoza — roleId o'rnatilmagan
  // lavozimlar uchun hali ham zaxira sifatida ishlatiladi.
  suggestedRole      String   @default("TEACHER") // TEACHER | MANAGER | ADMIN — login ochilganda taklif qilinadigan rol
  defaultPermissions String?  @default("[]") @db.Text // JSON array — ALL_PERMISSIONS kalitlari
  // YANGI (2026-09-14) — Sozlamalar > Rollar va Ruxsatlar sahifasida
  // yaratilgan haqiqiy Role'ga FK. O'rnatilgan bo'lsa, ensureStaffLoginAccount()
  // suggestedRole/defaultPermissions o'rniga shu Role'ning baseRoleLevel'i va
  // RolePermission to'plamidan hosila qiymatlarni ishlatadi (auth.ts'dagi
  // resolveRoleAssignment bilan bir xil naqsh — CrmUsers.tsx'dagi "Maxsus Rol"
  // ulanishiga o'xshab, endi Lavozim ham haqiqiy Role'ga bog'lanishi mumkin).
  roleId             String?
  roleRef            Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  staffMembers StaffMember[]
}

// ============================================
// ROLLAR VA RUXSATLAR (RBAC) — 2026-09-12
// ============================================
// Bosqichma-bosqich migratsiya: User.role (string) va User.permissions
// (JSON) ATAYLAB saqlanadi — eski kod ular orqali ishlashda davom etadi.
// Role/Permission — bir xil ma'lumotning relatsion, boshqariladigan
// versiyasi (Roles & Permissions UI shular bilan ishlaydi).

// Bo'lim — xodim qaysi funksional yo'nalishda ishlashini bildiradi.
// StaffMember.department (erkin matn) ATAYLAB saqlanadi — bu FK shunga
// qo'shimcha, tuzilgan versiya.
model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staffMembers StaffMember[]
}

// Rol — foydalanuvchi tizim ichida nima qila olishini belgilaydi
// (User.role erkin string'ining relatsion versiyasi). isSystem=true —
// TEACHER/MANAGER/ADMIN/SUPER_ADMIN kabi standart andozalar (o'chirib
// bo'lmaydi, faqat deaktivatsiya); admin keyinchalik o'z custom rolini
// ham yarata oladi (isSystem=false).
model Role {
  id          String   @id @default(uuid())
  name        String   @unique // "TEACHER" yoki "Katta O'qituvchi" kabi ichki kalit
  label       String   // ko'rsatiladigan nom
  description String?  @db.Text
  // Ushbu Role tanlangan foydalanuvchining User.role (ROLE_LEVEL) qiymati
  // qanday bo'lishi kerakligi — TEACHER/MANAGER/ADMIN/SUPER_ADMIN dan biri.
  // Muhim: bu Role.name bilan bir xil narsa EMAS — bitta baseRoleLevel'ga
  // ko'plab turli nomdagi Role (masalan "Matematika O'qituvchisi",
  // "IELTS O'qituvchisi") mos kelishi mumkin, farqi ularning RolePermission
  // to'plamida. ROLE_LEVEL/requireMinRole (server/middleware/auth.ts) hali
  // ham shu qiymat asosida ishlaydi — granular Permission tizimi buni
  // almashtirmaydi, ustiga qo'shiladi (arxitektura rejasiga qarang:
  // C:\Users\user\.claude\plans\cosmic-fluttering-quill.md).
  baseRoleLevel String @default("TEACHER")
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]
  positions   Position[]
}

// Ruxsat — bitta aniq imkoniyat (masalan "finance", "journal").
// src/constants/permissions.ts'dagi ALL_PERMISSIONS'ning DB versiyasi —
// migratsiya paytida seed qilinadi.
model Permission {
  id        String   @id @default(uuid())
  key       String   @unique // "finance", "journal", "quiz" va h.k.
  label     String
  group     String   // "Ta'lim", "Moliya" va h.k. — UI guruhlash uchun
  createdAt DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

// Individual istisno — Role bergan ruxsatdan tashqari, bitta
// foydalanuvchiga aniq ALLOW yoki DENY berish (masalan vaqtinchalik).
// validUntil o'tgan bo'lsa, authorization service buni e'tiborsiz
// qoldiradi.
model PermissionOverride {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation("PermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permissionKey String    // Permission.key bilan mos — ataylab FK emas,
                          // Permission o'chirilsa ham tarix saqlanadi
  effect        String    // "ALLOW" | "DENY"
  reason        String?   @db.Text
  grantedById   String?
  grantedBy     User?     @relation("PermissionOverridesGranted", fields: [grantedById], references: [id], onDelete: SetNull)
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  createdAt     DateTime  @default(now())

  // Bir foydalanuvchi uchun bitta ruxsat kalitida faqat BITTA joriy
  // override bo'lishi mumkin (qayta berilsa — yangi qator emas, shu
  // qator yangilanadi). Bu ikki qarama-qarshi override (masalan ikkita
  // "finance" uchun ALLOW) tasodifan paydo bo'lishining oldini oladi.
  @@unique([userId, permissionKey])
  @@index([userId])
}

// Moliyaviy kategoriyalar (kirim/chiqim) — admin o'zi qo'sha oladigan,
// boshqariladigan ro'yxat. Expense.category/Transaction.category/
// Budget.category haliham erkin matn (String) — bu jadval faqat UI uchun
// "ruxsat etilgan qiymatlar" ro'yxatini beradi. Eski yozuvlar bilan mos
// kelishi uchun o'chirilmaydi, faqat isActive=false qilinadi.
model TransactionCategory {
  id        String   @id @default(uuid())
  name      String
  type      String   // "income" | "expense"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // IP-12 (TQ-E): TUITION | OTHER_INCOME | PAYROLL_PAYOUT | STAFF_ADVANCE | OPERATING_EXPENSE | REFUND | TRANSFER
  kind      String?
  isSystem  Boolean?

  @@unique([name, type])
}

// ============================================
// LIDLAR (LEADS / VORONKA)
// ============================================

model Lead {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  stage     String   @default("new") // new, contacted, meeting, won, lost
  source    String?  // Instagram, Facebook, Telegram, etc.
  course    String?  // Qaysi kursga qiziqish (erkin matn)
  courseId  String?  // Kurslar ro'yxatidagi id (relation yo'q — faqat guruhlash uchun)
  score     Int      @default(0) // 0-100
  status    String   @default("warm") // hot, warm, cold
  date      String?
  notes     String?
  extraField String? // Sozlamalarda tanlangan qo'shimcha maydon qiymati (yosh yoki sinf)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Egalik va SLA
  assignedToId         String?
  assignedTo           User?     @relation("LeadOwner", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt           DateTime?
  firstResponseAt      DateTime?
  firstResponseMinutes Int?
  slaBreachedAt        DateTime?
  lastContactAt        DateTime?
  nextFollowUpAt       DateTime?
  nextAction           String?
  stageChangedAt       DateTime?

  // Atributsiya (UTM va kampaniya)
  campaignId  String?
  campaign    Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  formId      String?
  form        TargetForm? @relation(fields: [formId], references: [id], onDelete: SetNull)
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  clickId     String?  // gclid yoki fbclid
  landingPage String?
  referrer    String?

  // Konversiya
  studentId   String?
  student     Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  convertedAt DateTime?

  // Yo'qotish
  lostReason String?
  lostAt     DateTime?

  // Sifat / dublikat
  phoneNorm     String? // oxirgi 9 raqam
  searchKey     String? // lower(name + ' ' + phone + ' ' + course)
  duplicateOfId String?
  duplicateOf   Lead?   @relation("LeadDupe", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Lead[]  @relation("LeadDupe")
  submitCount   Int     @default(1)
  ipHash        String?

  activities LeadActivity[]

  @@index([deletedAt, stage])
  @@index([deletedAt, assignedToId])
  @@index([phoneNorm])
  @@index([searchKey])
  @@index([campaignId])
  @@index([formId])
  @@index([createdAt])
  @@index([nextFollowUpAt])
}

model LeadActivity {
  id          String    @id @default(uuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String    // call, message, meeting, note
  content     String
  date        String
  user        String    @default("Admin") // eski yozuvlar uchun ism (matn)
  createdAt   DateTime  @default(now())
  userId      String?
  userRef     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  outcome     String?   // answered, no_answer, busy, wrong_number, interested, not_interested
  direction   String?   // out, in
  durationSec Int?

  @@index([leadId])
  @@index([createdAt])
}

// ============================================
// MARKETING
// ============================================

model Campaign {
  id        String   @id @default(uuid())
  name      String
  platform  String   // Instagram, Facebook, Telegram, Google
  budget    Float    @default(0)
  spent     Float    @default(0)
  leads     Int      @default(0) // platforma o'zi ko'rsatgan lidlar soni (qo'lda kiritiladi)
  startDate String?
  endDate   String?
  status    String   @default("active") // active, paused, completed
  notes     String? @db.Text
  impressions Int    @default(0)
  clicks      Int    @default(0)
  utmSource   String?
  utmCampaign String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadRecords Lead[]
  forms       TargetForm[]

  @@index([status])
  @@index([utmCampaign])
}

// ============================================
// INVENTAR
// ============================================

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  category    String   @default("Texnika") // Texnika, Mebel, O'quv qurollari
  quantity    Int      @default(1)
  price       Float    @default(0)
  location    String?  // Xona nomi
  condition   String   @default("Yaxshi") // Yaxshi, O'rtacha, Yomon
  purchaseDate String?
  notes       String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions InventoryTransaction[]
}

// ============================================
// KONTENT VA YANGILIKLAR (BLOG/NEWS)
// ============================================

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String? @db.Text
  excerpt   String? @db.Text
  imageUrl  String?
  author    String?
  status    String   @default("Faol") // Faol, Qoralama, Arxiv
  category  String   @default("Yangilik") // Yangilik, Blog, E'lon
  date      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// TARGET FORMALAR
// ============================================

model TargetForm {
  id          String   @id @default(uuid())
  title       String
  description String?
  course      String?
  url         String?  @unique // eskirgan — endi yozilmaydi, /l/{shortCode} ishlatiladi
  shortCode   String?  @unique // qisqa ommaviy havola kodi (6 belgi) — server/routes/crud.ts CREATE'da generatsiya qiladi
  isActive    Boolean  @default(true)
  submissions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  views       Int      @default(0)
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  utmSource   String?
  utmCampaign String?

  // null = global Sozlamalar qiymatini meros oladi ('none'|'age'|'grade');
  // aniq qiymat berilsa shu forma uchun global sozlamani ustidan yozadi.
  extraFieldType String?

  // false = "Qaysi kursga qiziqasiz?" tanlovi shu formada yashiriladi (masalan,
  // reklama allaqachon bitta kursga bag'ishlangan bo'lsa). Standart true —
  // eski formalar oldingi xatti-harakatini saqlab qoladi.
  showCourseField Boolean @default(true)

  // Ariza yuborilgandan keyingi "muvaffaqiyat" ekrani — hammasi ixtiyoriy,
  // bo'sh bo'lsa LeadForm.tsx'dagi standart matn/tugma (Bosh sahifaga
  // qaytish) ishlatiladi. successButtonUrl faqat "/" bilan boshlangan ichki
  // yo'l yoki "http(s)://" bilan boshlangan tashqi havola bo'lsa qabul
  // qilinadi (LeadForm.tsx render vaqtida tekshiradi) — boshqa hech narsa
  // (masalan "javascript:") havola sifatida ishlatilmaydi.
  successTitle      String?
  successMessage    String?
  successButtonText String?
  successButtonUrl  String?

  leadRecords Lead[]

  @@index([isActive])
}

// ============================================
// SOZLAMALAR
// ============================================

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

// ============================================
// BILDIRISHNOMALAR
// ============================================

model Notification {
  id        String   @id @default(uuid())
