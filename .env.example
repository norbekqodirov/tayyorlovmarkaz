# ─── Server ──────────────────────────────────────────────────────────────────
# Node environment (development | production)
NODE_ENV="development"

# Port for Express server
PORT=3001

# Your public app URL (used for CORS and self-referential links)
APP_URL="http://localhost:3000"

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (local Docker)
DATABASE_URL="postgresql://tayyorlov:tayyorlov123@localhost:5432/tayyorlovmarkaz?schema=public"

# Optional: Shadow database for prisma migrate (needed for migration-based workflows)
# SHADOW_DATABASE_URL="postgresql://tayyorlov:tayyorlov123@localhost:5432/tayyorlovmarkaz_shadow?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED: Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# JWT expiration (e.g. 7d, 24h, 30m)
JWT_EXPIRES_IN="7d"

# ─── Redis (optional — for session/cache) ─────────────────────────────────────
# REDIS_URL="redis://localhost:6379"

# ─── AI (Optional) ────────────────────────────────────────────────────────────
# Gemini API key for AI-powered features
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ─── File Uploads ────────────────────────────────────────────────────────────
# Max file size for uploads (bytes)
MAX_FILE_SIZE=10485760

# Upload directory (relative to server root)
UPLOAD_DIR="uploads"

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# O'quvchi boti (asosiy bot) — BotFather dan olingan token
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Webhook xavfsizlik tokeni (ixtiyoriy, lekin tavsiya etiladi)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET="CHANGE_ME_RANDOM_32_BYTES_HEX"

# Xodim boti (Staff Bot) — alohida bot token
STAFF_BOT_TOKEN="YOUR_STAFF_BOT_TOKEN"
STAFF_WEBHOOK_SECRET="CHANGE_ME_STAFF_SECRET"

# Mini App URL'lari (Vite dev yoki production domen)
TELEGRAM_MINI_APP_URL="http://localhost:5173/portal"
STAFF_MINI_APP_URL="http://localhost:5173/staff-portal"

# Admin Telegram Chat ID'lari (vergul bilan ajratilgan)
TELEGRAM_ADMIN_IDS="123456789"

# ─── To'lov tizimlari (Payme / Click) ─────────────────────────────────────────
# Payme (Merchant ID va Secret Key — Payme biznes kabinetidan)
PAYME_MERCHANT_ID="YOUR_PAYME_MERCHANT_ID"
PAYME_SECRET_KEY="YOUR_PAYME_SECRET_KEY"
PAYME_TEST_MODE="true"

# Click (Service ID va Merchant ID)
CLICK_SERVICE_ID="YOUR_CLICK_SERVICE_ID"
CLICK_MERCHANT_ID="YOUR_CLICK_MERCHANT_ID"
CLICK_SECRET_KEY="YOUR_CLICK_SECRET_KEY"
